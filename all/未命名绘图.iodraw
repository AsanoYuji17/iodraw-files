        <mxCell id="Q31wl8vuDGYcLX8csPMc-1" value="当前信息集&#xa;    历史实际负荷与光伏&#xa;    最新光伏预报&#xa;    固定分时电价&#xa;    当前储电量" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
